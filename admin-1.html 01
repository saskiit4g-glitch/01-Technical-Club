<!doctype html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex"><title>لوحة الرئيس</title>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="style.css"></head><body>
<header><div style="display:flex;justify-content:center;gap:18px;background:#fff;border-radius:12px;padding:8px 16px;width:fit-content;margin:0 auto 10px"><img src="data:image/png;base64," height="52" alt="وزارة التعليم"><img src="data:image/png;base64," height="52" alt="مدرسة الإمام السخاوي"></div><h1>لوحة الرئيس</h1><p>النادي التقني</p></header>
<main>
<div class="box noprint"><label>الرقم السري<input id="pin" type="password"></label>
<label>تاريخ الجلسة<input id="date" type="date"></label>
<button onclick="loadDay()">دخول وعرض الأعضاء</button><div id="m1" class="msg" role="status"></div></div>
<div class="box" id="att" hidden><h2>تسجيل الحضور</h2><div id="list"></div>
<button onclick="save()" class="noprint">حفظ الحضور</button><div id="m2" class="msg" role="status"></div></div>
<div class="box" id="rep" hidden><h2>التقرير الشهري</h2>
<div class="noprint"><label>الشهر<input id="month" type="month"></label>
<button onclick="report()">عرض التقرير</button>
<button class="off" onclick="window.print()">طباعة</button></div>
<div id="out" class="wrap"></div></div>
</main>
<script src="config.js"></script>
<script>
const $=id=>document.getElementById(id);
const esc=s=>String(s).replace(/[&<>"']/g,c=>'&#'+c.charCodeAt(0)+';');
let pin='',L=[];
$('date').value=new Date().toLocaleDateString('en-CA');
$('month').value=$('date').value.slice(0,7);
async function api(o){
  o.pin=pin;
  const r=await fetch(API_URL,{method:'POST',body:JSON.stringify(o)});
  const j=await r.json();if(!j.ok)throw new Error(j.error);return j;
}
async function loadDay(){
  pin=$('pin').value;$('m1').textContent='جارٍ التحميل...';
  try{
    L=(await api({action:'day',date:$('date').value})).members;
    $('m1').textContent=L.length?'':'لا يوجد أعضاء مسجلون بعد.';
    $('att').hidden=false;$('rep').hidden=false;draw();
  }catch(e){$('m1').textContent=e.message}
}
function draw(){
  $('list').innerHTML=L.map((m,i)=>`<div class="row"><span>${esc(m.name)}</span><span>
  <button class="${m.s=='حاضر'?'':'off'}" onclick="mark(${i},'حاضر')">حاضر</button>
  <button class="${m.s=='غائب'?'a':'off'}" onclick="mark(${i},'غائب')">غائب</button></span></div>`).join('');
}
function mark(i,s){L[i].s=s;draw()}
async function save(){
  $('m2').textContent='جارٍ الحفظ...';
  try{await api({action:'save',date:$('date').value,records:L.filter(m=>m.s)});$('m2').textContent='تم حفظ الحضور ✓'}
  catch(e){$('m2').textContent=e.message}
}
async function report(){
  try{
    const j=await api({action:'report',month:$('month').value});
    $('out').innerHTML=`<p>عدد الجلسات: <b>${j.sessions}</b></p><table><tr><th>الاسم</th><th>حضور</th><th>غياب</th><th>النسبة</th></tr>`+
    j.rows.map(r=>`<tr><td>${esc(r.name)}</td><td>${r.p}</td><td>${r.a}</td><td>${r.pct}%</td></tr>`).join('')+'</table>';
  }catch(e){$('out').textContent=e.message}
}
</script></body></html>
