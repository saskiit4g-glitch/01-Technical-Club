<!doctype html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>النادي التقني | مدرسة الإمام السخاوي الثانوية</title>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;600;700&display=swap" rel="stylesheet">
<style>
:root{--g:#1d5a3a;--g2:#134029;--gold:#c8a23a;--cream:#fbf4e2;--ink:#23301f;--line:#e6d9b0}
*{box-sizing:border-box}html{scroll-snap-type:y proximity;scroll-behavior:smooth}
body{margin:0;font-family:'IBM Plex Sans Arabic',Tahoma,sans-serif;background:var(--cream);color:var(--ink);line-height:1.8}
section{min-height:100dvh;scroll-snap-align:start;display:flex;flex-direction:column;justify-content:center;align-items:center;padding:56px 18px;text-align:center}
.cover{background:linear-gradient(180deg,#fffaf0,var(--cream) 60%,#f3e6bd);border-bottom:6px solid var(--gold)}
.logos{display:flex;gap:16px;align-items:center;justify-content:center;margin-bottom:22px}
.logos img{height:84px}.logos .s{height:100px;border-radius:50%}.logos i{width:2px;height:70px;background:var(--gold)}
h1{font-size:clamp(2.6rem,10vw,4.6rem);margin:4px 0;color:var(--g)}h1 span{color:#b8921f}.eb{color:var(--g);font-weight:600;margin:0}
.lead{font-size:1.25rem;color:#7d610d;margin:0}
.btn{display:inline-block;background:var(--gold);color:var(--g2);padding:12px 30px;border-radius:8px;font:inherit;font-weight:700;text-decoration:none;margin-top:20px;border:0;cursor:pointer}
h2{color:var(--g);font-size:2rem;margin:0}h2::after{content:"";display:block;width:60px;height:4px;background:var(--gold);margin:6px auto 20px}
.w{max-width:780px;width:100%}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:14px;text-align:right}
.card{background:#fff;border:1px solid var(--line);border-top:4px solid var(--gold);border-radius:8px;padding:16px}
.card b{display:block;color:#9a7a15;font-size:1.7rem;line-height:1.3}
.two{display:flex;flex-wrap:wrap;gap:26px;align-items:center;justify-content:center}
.two img{max-height:66vh;max-width:100%;border-radius:10px;box-shadow:0 8px 24px #0003}
.alt{background:#f3e9c9}
form{text-align:right;background:#fff;border:1px solid var(--line);border-top:4px solid var(--gold);border-radius:8px;padding:18px}
label{display:block;font-weight:600;margin-top:12px}
input:not([type=checkbox]),select,textarea{width:100%;padding:11px;border:1px solid #cdbf8a;border-radius:6px;font:inherit;background:#fffdf6}
:focus-visible{outline:3px solid var(--gold)}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:6px}.chips label{margin:0;font-weight:400}
.chips input,.ok input{position:absolute;opacity:0}
.chips span{display:block;padding:5px 14px;border:1px solid #cdbf8a;border-radius:20px;background:#fffdf6;cursor:pointer}
.chips input:checked+span{background:var(--g);color:#fff;border-color:var(--g)}.chips input:focus-visible+span{outline:3px solid var(--gold)}
.ok{font-weight:400}.ok input{position:static;width:auto;margin-left:8px}
form .btn{background:var(--g);color:#fff;width:100%}.msg{margin-top:12px;font-weight:600}
.dots{position:fixed;left:10px;top:50%;transform:translateY(-50%);display:flex;flex-direction:column;gap:10px;z-index:5}
.dots a{width:12px;height:12px;border-radius:50%;border:2px solid var(--gold);background:#fff8}.dots a.on{background:var(--gold)}
.rv{opacity:0;transform:translateY(26px);transition:opacity .7s,transform .7s}.rv.in{opacity:1;transform:none}
  .av{width:64px;height:64px;margin:0 auto 8px;border-radius:50%;border:3px solid var(--gold);background:var(--g);color:var(--cream);display:grid;place-items:center;font-size:1.8rem;font-weight:700}.nm{font-size:1.25rem!important;color:var(--g)!important;line-height:1.5}
footer{font-size:.85rem;opacity:.8;margin-top:18px}
@media(max-width:600px){.dots{display:none}}
@media(prefers-reduced-motion:reduce){.rv{opacity:1;transform:none;transition:none}html{scroll-behavior:auto}}
</style></head><body>
<nav class="dots" aria-label="التنقل"></nav>

<section class="cover" id="s1">
<div class="logos rv"><img src="data:image/png;base64," alt="وزارة التعليم"><i></i><img class="s" src="data:image/png;base64," alt="شعار مدرسة الإمام السخاوي الثانوية"></div>
<p class="eb rv">مدرسة الإمام السخاوي الثانوية</p>
<h1 class="rv">النادي <span>التقني</span></h1>
<p class="lead rv">شغوف بالتقنية؟ مستقبلك يبدأ من هنا!</p>
<a class="btn rv" href="#reg">سجّل الآن</a>
</section>

<section id="s2"><div class="w">
<h2 class="rv">عن النادي</h2>
<p class="rv" style="font-size:1.2rem">مكانك المنظّم لتطوير مهاراتك والعمل على مشاريع حقيقية تمثّل المدرسة في المحافل الكبرى.</p>
<div class="grid">
<div class="card rv"><b>15–30</b>مقعداً فقط لضمان أعلى جودة تدريب</div>
<div class="card rv"><b>مشاريع</b>حقيقية تمثّل المدرسة</div>
<div class="card rv"><b>إشراف</b>تربوي من معلمي المدرسة</div>
</div></div></section>

<section class="alt" id="s3"><div class="w">
<h2 class="rv">مسارات النادي</h2>
<div class="grid">
<div class="card rv"><b>01</b>أساسيات البرمجة وتصميم وتطوير المواقع</div>
<div class="card rv"><b>02</b>أدوات وتقنيات الذكاء الاصطناعي (AI)</div>
<div class="card rv"><b>03</b>مبادئ الأمن السيبراني</div>
<div class="card rv"><b>04</b>بناء مشاريع رقمية جماعية للمدرسة</div>
</div></div></section>

<section id="s4"><div class="w">
<h2 class="rv">القيادة والإشراف</h2>
<div class="grid" style="text-align:center">
<div class="card rv"><div class="av">س</div><small>رئيس النادي</small><br><b class="nm">الطالب سامي نوح</b></div>
<div class="card rv"><div class="av">ي</div><small>المشرف العام</small><br><b class="nm">الأستاذ يوسف السهلي</b></div>
</div></div></section>

<section class="alt" id="reg"><div class="w">
<h2 class="rv">التسجيل في النادي</h2>
<form id="f" class="rv">
<label>الاسم الثلاثي<input name="name" required maxlength="100" autocomplete="name"></label>
<label>الصف<select name="grade" required><option value="">اختر</option><option>الأول الثانوي</option><option>الثاني الثانوي</option><option>الثالث الثانوي</option></select></label>
<label>رقم الجوال<input name="phone" type="tel" inputmode="tel" placeholder="05xxxxxxxx" required></label>
<label>المجالات التي تهمك (اختر واحداً أو أكثر)</label>
<div class="chips">
<label><input type="checkbox" name="f" value="برمجة وتطوير المواقع"><span>برمجة وتطوير المواقع</span></label>
<label><input type="checkbox" name="f" value="تصميم جرافيك وواجهات"><span>تصميم جرافيك وواجهات</span></label>
<label><input type="checkbox" name="f" value="الذكاء الاصطناعي"><span>الذكاء الاصطناعي</span></label>
<label><input type="checkbox" name="f" value="الأمن السيبراني"><span>الأمن السيبراني</span></label>
<label><input type="checkbox" name="f" value="الروبوتات والإلكترونيات"><span>الروبوتات والإلكترونيات</span></label>
<label><input type="checkbox" name="f" value="تطوير الألعاب"><span>تطوير الألعاب</span></label>
<label><input type="checkbox" name="f" value="تطبيقات الجوال"><span>تطبيقات الجوال</span></label>
<label><input type="checkbox" name="f" value="تحليل البيانات"><span>تحليل البيانات</span></label>
<label><input type="checkbox" name="f" value="المونتاج وصناعة المحتوى"><span>المونتاج وصناعة المحتوى</span></label>
</div>
<label>ما هدفك من الدخول في هذا المجال؟<textarea name="goal" rows="3" required maxlength="500"></textarea></label>
<label class="ok"><input type="checkbox" required>أوافق على استخدام بياناتي لأغراض تنظيم أنشطة النادي فقط.</label>
<button class="btn" id="btn">إرسال طلب التسجيل</button><div id="msg" class="msg" role="status"></div>
</form>
<p class="rv">بعد إرسال الاستمارة ستنتقل تلقائياً إلى محادثة رئيس النادي على واتساب لتأكيد تسجيلك.</p>
<footer>النادي التقني — مدرسة الإمام السخاوي الثانوية</footer>
</div></section>

<script src="config.js"></script>
<script>
const S=[...document.querySelectorAll('section')],D=document.querySelector('.dots');
S.forEach((s,i)=>{const a=document.createElement('a');a.href='#'+s.id;a.setAttribute('aria-label','القسم '+(i+1));D.append(a)});
new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){const i=S.indexOf(e.target);[...D.children].forEach((d,j)=>d.classList.toggle('on',i==j))}}),{rootMargin:'-45% 0px -45% 0px'}).observe&&S.forEach(s=>0);
const io2=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){const i=S.indexOf(e.target);[...D.children].forEach((d,j)=>d.classList.toggle('on',i==j))}}),{rootMargin:'-45% 0px -45% 0px'});S.forEach(s=>io2.observe(s));
const rv=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');rv.unobserve(e.target)}}),{threshold:.1});
document.querySelectorAll('.rv').forEach((x,i)=>{x.style.transitionDelay=(i%4)*.08+'s';rv.observe(x)});
const f=document.getElementById('f'),btn=document.getElementById('btn'),msg=document.getElementById('msg');
const norm=p=>p.replace(/[٠-٩]/g,c=>'٠١٢٣٤٥٦٧٨٩'.indexOf(c)).replace(/[۰-۹]/g,c=>'۰۱۲۳۴۵۶۷۸۹'.indexOf(c)).replace(/[\s\-()]/g,'').replace(/^(\+?966|00966)/,'0');
f.onsubmit=async e=>{
  e.preventDefault();const fd=new FormData(f);
  const phone=norm(fd.get('phone')),field=fd.getAll('f').join('، ');
  if(!/^05\d{8}$/.test(phone)){msg.textContent='اكتب رقم الجوال بصيغة 05xxxxxxxx (10 أرقام).';return}
  if(!field){msg.textContent='اختر مجالاً واحداً على الأقل.';return}
  btn.disabled=true;msg.textContent='جارٍ الإرسال...';
  try{
    const r=await fetch(API_URL,{method:'POST',body:JSON.stringify({action:'register',name:fd.get('name'),grade:fd.get('grade'),phone,field,goal:fd.get('goal')})});
    const j=await r.json();if(!j.ok)throw 0;
    f.reset();msg.textContent='✓ تم استلام طلبك. جارٍ تحويلك إلى رئيس النادي على واتساب لتأكيد التسجيل... ';
    if(j.wa){const a=document.createElement('a');a.href=j.wa;a.textContent='اضغط هنا إن لم يتم التحويل';msg.append(a);setTimeout(()=>{location.href=j.wa},2500)}
  }catch{msg.textContent='تعذّر الإرسال. تأكد من الاتصال وحاول مرة أخرى.'}
  btn.disabled=false;
};
</script></body></html>
